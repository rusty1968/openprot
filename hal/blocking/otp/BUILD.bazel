load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "driver",
    srcs = ["driver.rs"],
    crate_name = "hal_otp_driver",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "otp",
    srcs = ["otp.rs"],
    crate_name = "hal_otp",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":driver"],
)

rust_test(
    name = "otp_test",
    crate = ":otp",
    rustc_flags = [
        "-C",
        "debug-assertions",
    ],
)
