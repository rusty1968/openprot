load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "mctp_transport_i3c",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "openprot_mctp_transport_i3c",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@rust_crates//:mctp",
    ],
)

rust_test(
    name = "mctp_transport_i3c_test",
    crate = ":mctp_transport_i3c",
    deps = [
        "@rust_crates//:mctp",
    ],
)
