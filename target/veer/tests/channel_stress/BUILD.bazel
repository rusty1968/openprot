load("@pigweed//pw_kernel/tooling:multi_process_app.bzl", "multi_process_app")
load("@pigweed//pw_kernel/tooling:rust_process.bzl", "rust_process")
load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/veer:defs.bzl", "TARGET_COMPATIBLE_WITH")
load("//target/veer/tooling:caliptra_runner.bzl", "caliptra_runner", "caliptra_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/riscv:arch_riscv",
    system_config = ":system_config",
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    template = "//target/veer:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/veer:entry",
        "@pigweed//pw_kernel/arch/riscv:arch_riscv",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

# Two processes exercising only the kernel channel-IPC syscalls.
multi_process_app(
    name = "channel_stress",
    processes = [
        ":server",
        ":client",
    ],
    tags = ["kernel"],
)

rust_process(
    name = "server",
    srcs = ["server.rs"],
    codegen_crate_name = "chanstress_server_codegen",
    edition = "2024",
    tags = ["kernel"],
    deps = [
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_process(
    name = "client",
    srcs = ["client.rs"],
    codegen_crate_name = "chanstress_client_codegen",
    edition = "2024",
    tags = ["kernel"],
    deps = [
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
    ],
)

system_image(
    name = "channel_stress_image",
    apps = [":channel_stress"],
    kernel = ":target",
    platform = "//target/veer",
    system_config = ":system_config",
    tags = ["kernel"],
)

rust_binary_no_panics_test(
    name = "no_panics_test",
    binary = ":channel_stress_image",
    tags = ["kernel"],
)

caliptra_runner(
    name = "channel_stress_runner",
    interface = "emulator",
    tags = ["manual"],
    target = ":channel_stress_image",
)

# Self-contained: no I3C traffic. caliptra_test runs the image under the emulator
# and passes/fails on the PASS / FAIL sentinel the target's shutdown() logs.
caliptra_test(
    name = "channel_stress_test",
    timeout = "long",
    interface = "emulator",
    # caliptra_runner.py hardcodes --i3c-port=65534; must not run in parallel.
    tags = [
        "emulator",
        "exclusive",
    ],
    target = ":channel_stress_image",
)
