// VeeR PLDM throughput benchmark with the i3c and MCTP servers merged into one
// process (//target/veer/tests/mctp_i3c_colo), removing the IPC boundary between
// them (see pldm_throughput for the three-process layout).
//
// One app, two processes:
//
//   mctp_i3c_colo -- owns the I3C peripheral and PIC IRQ 2 and runs the MCTP
//                    router over an in-process i3c transport. Serves MCTP app
//                    clients on channel handler "mctp".
//   pldm_fd       -- an MCTP app client (initiator "mctp" -> mctp_i3c_colo
//                    "mctp") running the PLDM firmware device.
//
// Addresses are rendered per platform (emulator or FPGA) from upstream
// caliptra-mcu-sw's memory maps by `veer_system_config`:
//   @KERNEL_FLASH_START@  MCU SRAM start (code + data execute here)
//   @KERNEL_RAM_START@    app data, 0x40000 into MCU SRAM
//   @I3C_BASE@            I3C register block (device-mapped into the server)
{
  arch: {
    type: "riscv",
  },
  kernel: {
    flash_start_address: @KERNEL_FLASH_START@,
    flash_size_bytes: 0x10000,
    ram_start_address: @KERNEL_RAM_START@,
    ram_size_bytes: 0x8000,
  },
  apps: [
    {
      name: "pldm_throughput_colo",
      flash_size_bytes: 0x30000,
      processes: [
        {
          name: "mctp_i3c_colo",
          ram_size_bytes: 0x10000,
          objects: [
            { name: "wg", type: "wait_group" },
            {
              name: "i3c_irq",
              type: "interrupt",
              irqs: [{ name: "i3c", number: 2 }],
            },
            { name: "mctp", type: "channel_handler" },
            {
              type: "thread",
              name: "mctp_i3c_colo_thread",
              kernel_stack_size_bytes: 4096,
            },
          ],
          memory_mappings: [
            {
              name: "i3c_regs",
              type: "device",
              start_address: @I3C_BASE@,
              size_bytes: 0x1000,
            },
          ],
        },
        {
          name: "pldm_fd",
          ram_size_bytes: 0x10000,
          objects: [
            {
              name: "mctp",
              type: "channel_initiator",
              handler_process: "mctp_i3c_colo",
              handler_object_name: "mctp",
            },
            {
              type: "thread",
              name: "pldm_fd_thread",
              kernel_stack_size_bytes: 4096,
            },
          ],
        },
      ],
    },
  ],
}
