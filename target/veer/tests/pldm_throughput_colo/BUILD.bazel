load("@pigweed//pw_kernel/tooling:multi_process_app.bzl", "multi_process_app")
load("@pigweed//pw_kernel/tooling:rust_app.bzl", "rust_process")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/veer:defs.bzl", "TARGET_COMPATIBLE_WITH", "veer_system_config", "veer_system_image")
load("//target/veer/tooling:caliptra_runner.bzl", "caliptra_test")

package(default_visibility = ["//visibility:public"])

veer_system_config(
    name = "system_config",
    src = "system.json5.tmpl",
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/riscv:arch_riscv",
    system_config = ":system_config",
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    template = "//target/veer:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["//target/veer/tests/pldm_i3c:target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/veer:entry",
        "@pigweed//pw_kernel/arch/riscv:arch_riscv",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

# The i3c and MCTP servers merged into one process, and the PLDM firmware device
# as in pldm_throughput.
multi_process_app(
    name = "pldm_throughput_colo",
    processes = [
        ":mctp_i3c_colo",
        ":pldm_fd",
    ],
    tags = ["kernel"],
)

rust_process(
    name = "mctp_i3c_colo",
    srcs = ["//target/veer/tests/mctp_i3c_colo:process.rs"],
    codegen_crate_name = "mctp_i3c_colo_codegen",
    edition = "2024",
    tags = ["kernel"],
    deps = [
        "//target/veer/tests/mctp_i3c_colo",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
    ],
)

rust_process(
    name = "pldm_fd",
    srcs = ["//target/veer/tests/pldm_throughput:pldm_fd.rs"],
    codegen_crate_name = "pldm_fd_codegen",
    edition = "2024",
    tags = ["kernel"],
    deps = [
        "//services/mctp/client-ipc:mctp_client_ipc",
        "//target/veer/tests/pldm_fd",
        "@pigweed//pw_kernel/userspace",
    ],
)

veer_system_image(
    name = "pldm_throughput_colo_image",
    apps = [":pldm_throughput_colo"],
    kernel = ":target",
    platform = "//target/veer",
    system_config = ":system_config",
    tags = ["kernel"],
)

rust_binary_no_panics_test(
    name = "no_panics_test",
    binary = ":pldm_throughput_colo_image",
    tags = ["kernel"],
)

# The host side is a PLDM update agent (//target/veer/tests/pldm_ua) over
# caliptra_mcu_hw_model that times the download. It is a benchmark, so it is
# `manual` (not part of `//...`) and may run for minutes on the board. Generates
# pldm_throughput_colo_test_emulator and pldm_throughput_colo_test_fpga.
caliptra_test(
    name = "pldm_throughput_colo_test",
    srcs = ["//target/veer/tests/pldm_throughput:host_test.rs"],
    mcu_image = ":pldm_throughput_colo_image",
    tags = ["manual"],
    timeout = "eternal",
    deps = [
        "//target/veer/tests/host_util",
        "//target/veer/tests/pldm_ua",
        "//third_party/caliptra/caliptra-mcu-sw:mcu_testing_common",
    ],
)
