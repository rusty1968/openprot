load("@rules_rust//rust:defs.bzl", "rust_library")
load("//target/veer:defs.bzl", "TARGET_COMPATIBLE_WITH")

package(default_visibility = ["//target/veer/tests:__subpackages__"])

# The i3c server and the MCTP server in one process (no IPC between them), for
# the colocated benchmark images.
rust_library(
    name = "mctp_i3c_colo",
    srcs = ["lib.rs"],
    crate_name = "veer_mctp_i3c_colo",
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/i3c/api:i3c_api",
        "//services/i3c/client:i3c_client",
        "//services/i3c/server:i3c_server",
        "//services/i3c/server-runtime:i3c_server_runtime",
        "//services/mctp/server:mctp_server_lib",
        "//services/mctp/server-runtime:mctp_server_runtime",
        "//services/mctp/transport-i3c:mctp_transport_i3c",
        "//target/veer/peripherals/i3c",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:mctp",
    ],
)

# The process wrapper, built into each image that runs the colocated server.
exports_files(
    ["process.rs"],
    visibility = ["//target/veer/tests:__subpackages__"],
)
