// Colocated variant of i3c_throughput: the i3c_server and mctp_server processes
// are MERGED into one (`mctp_i3c_colo`), removing the mctp<->i3c IPC boundary.
// The MCTP router reaches the I3C target in-process via i3c_server::dispatch
// instead of a pw_kernel channel. Two processes instead of three; the sink stays
// isolated over the `mctp` channel. Compare throughput against i3c_throughput to
// price that boundary.
{
  arch: {
    type: "riscv",
  },
  kernel: {
    flash_start_address: 0x40000000,
    flash_size_bytes: 0x10000,
    ram_start_address: 0x40040000,
    ram_size_bytes: 0x8000,
  },
  apps: [
    {
      name: "i3c_throughput_colo",
      flash_size_bytes: 0x30000,
      processes: [
        {
          name: "mctp_i3c_colo",
          ram_size_bytes: 0x10000,
          objects: [
            { name: "wg", type: "wait_group" },
            {
              name: "i3c_irq",
              type: "interrupt",
              irqs: [{ name: "i3c", number: 2 }],
            },
            { name: "mctp", type: "channel_handler" },
            {
              type: "thread",
              name: "mctp_i3c_colo_thread",
              kernel_stack_size_bytes: 4096,
            },
          ],
          memory_mappings: [
            {
              name: "i3c_regs",
              type: "device",
              start_address: 0x20004000,
              size_bytes: 0x1000,
            },
          ],
        },
        {
          name: "throughput_sink",
          ram_size_bytes: 0x4000,
          objects: [
            {
              name: "mctp",
              type: "channel_initiator",
              handler_process: "mctp_i3c_colo",
              handler_object_name: "mctp",
            },
            {
              type: "thread",
              name: "throughput_sink_thread",
              kernel_stack_size_bytes: 2048,
            },
          ],
          memory_mappings: [
            {
              name: "rv_timer",
              type: "device",
              start_address: 0x21000000,
              size_bytes: 0x100,
            },
          ],
        },
      ],
    },
  ],
}
