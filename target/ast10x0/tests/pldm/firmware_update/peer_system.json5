// AST10x0 PLDM firmware-update test, mock-BMC side (the Update Agent).
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1792,
    },
    kernel: {
        flash_start_address: 0x00000700,
        flash_size_bytes: 63744,
        ram_start_address: 0x00020000,
        ram_size_bytes: 81920,
    },
    apps: [
        {
            name: "mctp_i2c_server_peer",
            flash_size_bytes: 32768,
            processes: [
                {
                    name: "mctp_i2c_server_peer_process",
                    ram_size_bytes: 131072,
                    objects: [
                        {
                            name: "wg",
                            type: "wait_group",
                        },
                        {
                            name: "mctp",
                            type: "channel_handler",
                        },
                        {
                            name: "i2c2_irq",
                            type: "interrupt",
                            irqs: [
                                {
                                    name: "i2c2",
                                    number: 112,
                                },
                            ],
                        },
                        {
                            type: "thread",
                            name: "mctp_i2c_server_peer_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                    memory_mappings: [
                        {
                            // The slave RX DMA buffer, in the non-cached SRAM window
                            // (0xA0000+, outside the cacheable area) so the CPU reads
                            // what the DMA engine wrote. The kernel's own `.ram_nc`
                            // statics start at 0xA0000; this sits clear of them.
                            name: "i2c_slave_dma",
                            type: "read_write_data",
                            start_address: 0x000a1000,
                            size_bytes: 0x200,
                        },
                        {
                            // The master TX/RX DMA staging buffer, in the same non-cached
                            // window and for the same reason as `i2c_slave_dma`.
                            name: "i2c_master_dma",
                            type: "read_write_data",
                            start_address: 0x000a2000,
                            size_bytes: 0x1000,
                        },
                        {
                            name: "i2c_regs",
                            type: "device",
                            start_address: 0x7e7b0000,
                            size_bytes: 0x4000,
                        },
                    ],
                },
            ],
        },
        {
            name: "pldm_ua",
            flash_size_bytes: 32768,
            processes: [
                {
                    name: "pldm_ua_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "mctp",
                            type: "channel_initiator",
                            handler_process: "mctp_i2c_server_peer_process",
                            handler_object_name: "mctp",
                        },
                        {
                            type: "thread",
                            name: "pldm_ua_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                    memory_mappings: [
                        {
                            name: "gpio_regs",
                            type: "device",
                            start_address: 0x7e780000,
                            size_bytes: 0x1000,
                        },
                        {
                            name: "spi1_regs",
                            type: "device",
                            start_address: 0x7e630000,
                            size_bytes: 0x1000,
                        },
                        {
                            name: "spi1_cs0_window",
                            type: "device",
                            start_address: 0x90000000,
                            size_bytes: 0x04000000,
                        },
                        // This board's own boot flash, on FMC CS0. FMC pinctrl is
                        // applied by the kernel target's pre-task init.
                        {
                            name: "fmc_regs",
                            type: "device",
                            start_address: 0x7e620000,
                            size_bytes: 0x1000,
                        },
                        {
                            name: "fmc_cs0_window",
                            type: "device",
                            start_address: 0x80000000,
                            size_bytes: 0x800000,
                        },
                    ],
                },
            ],
        },
    ],
}
