// AST10x0 External (host) Flash Service Configuration
// ARM Cortex-M4 @ 200 MHz with 768KB SRAM (0x00000000 - 0x000BFFFF)
// NOTE: AST10x0 does not support XIP - firmware executes from RAM.
//
// This image serves the external BMC SPI flash on SPI1, routed through the
// SPI monitor SPIM0 path. Unlike the FMC service, the server process programs
// the SCU internal SPI-master mux (and the paired SPIM GPIO pins) around every
// operation, so it maps the SCU and GPIO register blocks in addition to the
// SPI1 controller and its read window.
//
// PMSAv7-Friendly Memory Layout (same as ../flash/system.json5):
//   0x00000000 - 0x00000500: Vector table (1280 bytes)
//   0x00000500 - 0x00020000: Kernel code (~126KB, ends at 128KB boundary)
//   0x00020000 - 0x00060000: Server + client app flash (256KB)
//   0x00060000 - 0x00080000: Kernel RAM (128KB)
//   0x00080000 - 0x000A0000: App RAM (128KB)
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1280,  // 0x500
    },
    kernel: {
        flash_start_address: 0x00000500,  // After vector table
        flash_size_bytes: 129792,         // ~126KB (ends at 0x00020000)
        ram_start_address: 0x00060000,    // After all flash regions
        ram_size_bytes: 131072,           // 128KB
    },
    apps: [
        {
            name: "ext_flash_server_bin",
            flash_size_bytes: 131072,     // 128KB for server code
            processes: [
                {
                    name: "ext_flash_server_process",
                    ram_size_bytes: 65536,        // 64KB RAM (holds the 4KB+ IPC buffer)
                    objects: [
                        {
                            name: "ext_flash",
                            type: "channel_handler",  // Server side of client→server channel
                        },
                        {
                            type: "thread",
                            name: "ext_flash_server_thread",
                            kernel_stack_size_bytes: 4096,  // 4KB stack
                        },],
                    memory_mappings: [
                        // SPI1/SPIM0 pinctrl and passthrough/ext-mux routing are
                        // applied by the kernel target's pre-task init. The
                        // per-operation internal SPI-master detour, however, is
                        // driven from this process, so it maps the SCU and GPIO
                        // blocks as well as the SPI1 controller and window.
                        {
                            // SPI1 controller registers.
                            name: "spi1_regs",
                            type: "device",
                            start_address: 0x7e630000,
                            size_bytes: 0x1000,
                        },
                        {
                            // SPI1 CS0 memory-mapped flash read window (32 MiB).
                            name: "spi1_cs0_window",
                            type: "device",
                            start_address: 0x90000000,
                            size_bytes: 0x2000000,
                        },
                        {
                            // SCU: internal SPI-master mux (SCU0F0) and paired
                            // SPIM pin-function / MISO controls.
                            name: "scu_regs",
                            type: "device",
                            start_address: 0x7e6e2000,
                            size_bytes: 0x1000,
                        },
                        {
                            // GPIO: paired SPIM CLK/CS pins toggled around each
                            // RoT-master transaction (proprietary pre/post config).
                            name: "gpio_regs",
                            type: "device",
                            start_address: 0x7e780000,
                            size_bytes: 0x1000,
                        },
                    ],
                },
            ],
        },
        {
            name: "ext_flash_client_app",
            flash_size_bytes: 65536,      // 64KB for client code
            processes: [
                {
                    name: "ext_flash_client_process",
                    ram_size_bytes: 32768,        // 32KB RAM
                    objects: [
                        {
                            name: "ext_flash",
                            type: "channel_initiator",
                            handler_process: "ext_flash_server_process",
                            handler_object_name: "ext_flash",
                        },
                        {
                            type: "thread",
                            name: "ext_flash_client_thread",
                            kernel_stack_size_bytes: 2048,
                        },],
                },
            ],
        },
    ],
}
